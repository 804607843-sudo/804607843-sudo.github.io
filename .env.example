# Environment Variables
# .env is loaded in all environments (dev/build/serve).
# .env.development / .env.production override per NODE_ENV.
# REACT_APP_ prefix is required for client-side access.

# SSO partition (cn / sg / etc.)
REACT_APP_PARTITION=cn

# Optional backend base URL. Empty means same-origin /api.
# EDENX_PUBLIC_API_BASE_URL takes precedence over VITE_API_BASE_URL.
EDENX_PUBLIC_API_BASE_URL=
VITE_API_BASE_URL=
